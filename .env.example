# .env.example — copy to .env and edit:   cp .env.example .env
# .env is gitignored and must NEVER be committed.
#
# Easiest way to fill this in: run `python main.py` -> 10) Configure credentials.
# It explains each field (including how to get the Jira cookie blob), hides
# secret input, and writes .env for you.
#
# In production these are NOT read from a file — Jenkins binds them from its
# Credentials store (see Jenkinsfile). Lines starting with # are inactive;
# uncomment only what you use.

# ─────────────────────── Atlassian (required) ───────────────────────
SITE_JIRA=https://<YOUR_SITE>.atlassian.net
SITE_CONFLUENCE=https://<YOUR_SITE>.atlassian.net/wiki

# Confluence auth — API token from https://id.atlassian.com/manage-api-tokens
ATL_EMAIL=
ATL_TOKEN=

# Jira auth — browser session cookie blob (Jira's endpoint is UI-gated).
# Easiest: open .../secure/admin/CloudExport.jspa, F12 -> Network, reload, right-click
# the 'CloudExport.jspa' (or /rest/backup/1/export/...) request -> Copy as cURL, and
# paste the whole thing — the menu (option 10) extracts the cookies for you.
# Must include at least: tenant.session.token and atlassian.xsrf.token.
# (JSESSIONID / AWSALB / AWSALBCORS are sent automatically if your instance uses
# them — not all do.) Expires ~30 days. NEVER commit a real value.
JIRA_COOKIES=

# ─────────────────────── Archive ───────────────────────
# Blank password = unencrypted archive (or pass --no-encrypt).
# Compression: 0 = fastest/largest … 9 = slowest/smallest.
ARCHIVE_PASSWORD=
ARCHIVE_COMPRESSION=5

# Filename templates. Tokens: {product} {site} {date} {time} {datetime} {timestamp}
PRODUCT_NAME_TEMPLATE={product}-{date}
ARCHIVE_NAME_TEMPLATE=atlassian-backup-{date}

# Jenkins schedule (cron). Carried to Jenkins by the export. Default = Thursday ~02:00.
BACKUP_CRON=H 2 * * 4

# Max seconds to wait for each backup (Jira/Confluence) to finish before timing out.
# Exports can take from minutes to several hours; default 21600 = 6h.
POLL_TIMEOUT=21600

# Pipeline failure policy (carried to Jenkins; how each outcome is handled):
#   balanced  = hard-fail on expired credentials / backup error / no-backup;
#               continue (UNSTABLE) on cooldown + upload-target failures   [default]
#   resilient = never abort, only mark the build UNSTABLE
#   strict    = abort on anything that isn't a clean success
FAILURE_POLICY=balanced

# On the Jira 48h cooldown: 'skip' (mark unstable) or 'download-existing'
# (download the most recent existing backup instead).
JIRA_COOLDOWN_ACTION=skip

# Jenkins agent Python interpreter (blank = auto-detect python/py/python3). Set a
# full path only if 'python' isn't on the Jenkins service account's PATH, e.g.
# PYTHON_BIN=C:\Users\you\AppData\Local\Programs\Python\Python311\python.exe

# If 7z is not on PATH (e.g. local Windows testing):
# SEVEN_ZIP_PATH=C:\Program Files\7-Zip\7z.exe

# ─────────────────────── Storage ───────────────────────
# Provider: local | gcs | s3 | azure   (only 'local' needs no account/SDK)
# For MULTIPLE targets, use aligned comma lists, e.g.
#   STORAGE_PROVIDER=gcs,s3
#   STORAGE_DEST=my-gcs-bucket,my-s3-bucket
STORAGE_PROVIDER=local
STORAGE_DEST=./backups

# --- gcs ---   pip install -r requirements-gcs.txt
# STORAGE_PROVIDER=gcs
# STORAGE_DEST=<YOUR_BUCKET>
# GOOGLE_APPLICATION_CREDENTIALS=./sa-key.json

# --- s3 / S3-compatible (R2, B2, MinIO, Spaces) ---   pip install -r requirements-s3.txt
# STORAGE_PROVIDER=s3
# STORAGE_DEST=<YOUR_BUCKET>
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# S3_ENDPOINT_URL=                       # set only for R2/B2/MinIO/Spaces

# --- azure ---   pip install -r requirements-azure.txt
# STORAGE_PROVIDER=azure
# STORAGE_DEST=<YOUR_CONTAINER>
# AZURE_STORAGE_CONNECTION_STRING=

# ─────────────────────── Notifications (optional) ───────────────────────
# Comma list, or leave blank for none.
#   slack | discord | teams | google-chat  (share NOTIFY_WEBHOOK_URL)
#   email                                  (needs SMTP_* below)
#   webhook                                (raw JSON POST to NOTIFY_WEBHOOK_URL)
NOTIFY_CHANNELS=

# NOTIFY_WEBHOOK_URL=
# SMTP_HOST=
# SMTP_PORT=587                           # 465 = SSL, 587 = STARTTLS
# SMTP_STARTTLS=true
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_TO=
