# .env.example — template for LOCAL TESTING only.
#
# Copy to .env and fill in real values:   cp .env.example .env
# .env is gitignored and must NEVER be committed.
#
# In production these are NOT read from a file — Jenkins binds them from the
# Credentials store via withCredentials (see Jenkinsfile). This template exists
# so you can run the modules locally against a non-prod Atlassian instance.

# ════════════════════════════════════════════════════════════════════
# Atlassian source (not secret, but instance-specific)
# ════════════════════════════════════════════════════════════════════
SITE_JIRA=https://<YOUR_SITE>.atlassian.net
SITE_CONFLUENCE=https://<YOUR_SITE>.atlassian.net/wiki

# ── Jira auth: browser session cookie blob ──
# Semicolon-separated cookie string copied from DevTools (see README "Cookie
# Refresh Procedure"). Must contain: tenant.session.token, atlassian.xsrf.token,
# JSESSIONID, AWSALB, AWSALBCORS. Expires ~30 days. NEVER commit a real value.
JIRA_COOKIES=tenant.session.token=<JWT>; atlassian.xsrf.token=<XSRF>; JSESSIONID=<ID>; AWSALB=<ALB>; AWSALBCORS=<ALBCORS>

# ── Confluence auth: Basic (email + API token) ──
# API token from https://id.atlassian.com/manage-api-tokens
ATL_EMAIL=you@example.com
ATL_TOKEN=<YOUR_ATLASSIAN_API_TOKEN>

# ── Archive encryption & compression ──
# Leave ARCHIVE_PASSWORD blank to create an UNENCRYPTED archive (or pass
# --no-encrypt). ARCHIVE_COMPRESSION: 0=store (fastest) … 9=ultra (smallest).
ARCHIVE_PASSWORD=<STRONG_PASSPHRASE>
ARCHIVE_COMPRESSION=5

# ── Filename templates (optional) ──
# Tokens: {product} {site} {date} {time} {datetime} {timestamp} {year}{month}{day}
#   PRODUCT_NAME_TEMPLATE -> the per-product .zip (jira / confluence)
#   ARCHIVE_NAME_TEMPLATE -> the encrypted .7z bundle
PRODUCT_NAME_TEMPLATE={product}-{date}
ARCHIVE_NAME_TEMPLATE=atlassian-backup-{date}

# If 7z is not on PATH (e.g. local Windows testing):
# SEVEN_ZIP_PATH=C:\Program Files\7-Zip\7z.exe

# ════════════════════════════════════════════════════════════════════
# Storage backend — set ONE provider, fill only that block.
#   provider: gcs | s3 | azure | local      (CLI: --provider)
#   dest:     bucket / container / directory (CLI: --dest)
# ════════════════════════════════════════════════════════════════════
STORAGE_PROVIDER=gcs
STORAGE_DEST=<YOUR_BUCKET>

# --- gcs ---  (pip install -r requirements-gcs.txt)
GOOGLE_APPLICATION_CREDENTIALS=./sa-key.json

# --- s3 / S3-compatible ---  (pip install -r requirements-s3.txt)
# Works with AWS S3 and, via S3_ENDPOINT_URL, Cloudflare R2 / Backblaze B2 /
# MinIO / DigitalOcean Spaces.
AWS_ACCESS_KEY_ID=<KEY_ID>
AWS_SECRET_ACCESS_KEY=<SECRET>
AWS_DEFAULT_REGION=us-east-1
S3_ENDPOINT_URL=

# --- azure ---  (pip install -r requirements-azure.txt)
AZURE_STORAGE_CONNECTION_STRING=<CONNECTION_STRING>

# --- local ---  (no SDK; STORAGE_DEST is a directory path)
# STORAGE_DEST=/mnt/backups

# ════════════════════════════════════════════════════════════════════
# Notifications — comma list of channels.
#   google-chat | slack | discord | teams | email | webhook
# ════════════════════════════════════════════════════════════════════
NOTIFY_CHANNELS=google-chat

# Webhook-based channels (google-chat/slack/discord/teams/webhook) share one URL:
NOTIFY_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/<SPACE>/messages?key=<KEY>&token=<TOKEN>

# Email channel (SMTP) — only needed if 'email' is in NOTIFY_CHANNELS:
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=<SMTP_USER>
SMTP_PASSWORD=<SMTP_PASSWORD>
SMTP_FROM=backups@example.com
SMTP_TO=ops@example.com
